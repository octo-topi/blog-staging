{
  "name": "parcoursup",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "integration-propositions": "node src/integration-propositions.js",
    "format": "npx prettier *.js --write",
    "database:start": "docker compose up --wait",
    "database:stop": "docker compose down",
    "database:create-schema": "knex migrate:latest",
    "database:console": "psql --dbname \"host=localhost port=5400 dbname=database user=user password=password\""
  },
